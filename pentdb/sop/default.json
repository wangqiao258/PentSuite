{
  "description": "PentDB SOP 提示清单（扁平结构，无阶段）：给 AI 的查漏补缺提示层（非门禁）。AI 按语义判断 when 是否命中当前目标面，命中后对照 check 逐项自查，缺什么补什么——未命中或确认不适用即可跳过，不强制、不自动登记。同一术语可在多个 when 下重复出现（不同触发语义各自成项）。How 归 AI 现场判断与 pentest-kb 经验库。",
  "principles": [
    "hints 是提示不是限制：命中才对照，未命中可跳过，SOP 外的机会点自由探索",
    "对账靠 AI 显式申报（检查点/收尾写明未测项与原因），不靠机器关键词判定覆盖",
    "已证伪（negative/inconclusive）的测试不重测；破坏性动作受 notes.md §0 授权约束"
  ],
  "hints": [
    {"when": "常规（每项目必做）", "check": ["归属确认", "in-scope 标定", "指纹识别"]},
    {"when": "新发现域名", "check": ["归属"]},
    {"when": "常规（每项目必做）", "check": ["存活探测", "面板指纹"]},
    {"when": "常规（每项目必做）", "check": ["服务识别", "版本核验"]},
    {"when": "发现 mysql 服务", "check": ["弱口令", "CVE 核验", "exploit 比对"]},
    {"when": "发现 tomcat", "check": ["manager", "nuclei"]},
    {"when": "发现 http 服务", "check": ["目录扫描"]},
    {"when": "常规（每项目必做）", "check": ["目录爆破", "敏感文件"]},
    {"when": "发现 200 路径", "check": ["内容核验"]},
    {"when": "常规（每项目必做）", "check": ["认证与会话", "安全配置", "业务逻辑"]},
    {"when": "发现登录/认证入口", "check": ["弱口令", "爆破|暴力破解", "锁定策略"]},
    {"when": "多用户/角色/uid 类参数", "check": ["越权|IDOR"]},
    {"when": "带参数的页面/接口（200）", "check": ["注入探测", "越权|IDOR"]},
    {"when": "上传入口", "check": ["文件上传|任意文件上传"]},
    {"when": "搜索/列表/导出功能", "check": ["注入探测", "信息枚举"]},
    {"when": "发现 exposure 类 finding", "check": ["利用评估"]},
    {"when": "有候选漏洞", "check": ["影响证明", "可复现 PoC"]},
    {"when": "常规（每项目必做）", "check": ["报告产出", "豁免清单裁决"]}
  ]
}
