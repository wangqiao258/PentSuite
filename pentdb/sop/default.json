{
  "description": "PentDB 默认 SOP 必测规则。只定义 What（该测什么），How 归 AI 现场判断与 pentest-kb 经验库。语义适配 raw_events 单表。",
  "principles": [
    "SOP 是下限不是上限：发现 SOP 外的机会点必须自由登记 pending",
    "已证伪（negative/inconclusive）的测试不重排进队列",
    "破坏性动作永远受 notes.md §0 授权约束，本引擎不做授权判断"
  ],
  "rules": [
    {"id": "R1", "stage": "漏洞探测", "match": {"kind": "port", "service_or_note_contains": "mysql"},
     "require_tests": ["弱口令", "CVE 核验", "exploit 比对"]},
    {"id": "R2", "stage": "漏洞探测", "match": {"kind": "port", "service_or_note_contains": "tomcat"},
     "require_tests": ["nuclei", "manager"]},
    {"id": "R3", "stage": "漏洞探测", "match": {"kind": "port", "service_or_note_contains": "http"},
     "require_tests": ["目录扫描"]},
    {"id": "R4", "stage": "漏洞探测", "match": {"kind": "path", "code": "200"},
     "require_tests": ["内容核验"]},
    {"id": "R5", "stage": "漏洞探测", "match": {"kind": "param", "parent_code": "200"},
     "require_tests": ["注入探测", "越权|IDOR"]},
    {"id": "R6", "stage": "漏洞探测", "match": {"kind": "finding", "value_contains": "exposure"},
     "require_tests": ["利用评估"]},
    {"id": "R7", "stage": "资产梳理", "match": {"kind": "domain", "note_contains": "新发现"},
     "require_tests": ["归属"]}
  ],
  "stages": ["资产梳理", "子域枚举", "端口扫描", "目录扫描", "漏洞探测", "利用验证", "报告收尾"],
  "stage_required": {
    "资产梳理": ["归属确认", "in-scope 标定", "指纹识别"],
    "子域枚举": ["存活探测", "面板指纹"],
    "端口扫描": ["服务识别", "版本核验"],
    "目录扫描": ["目录爆破", "敏感文件"],
    "漏洞探测": ["认证与会话", "注入类", "访问控制|越权", "文件上传|SSRF", "业务逻辑", "安全配置"],
    "利用验证": ["影响证明", "可复现 PoC"],
    "报告收尾": ["报告产出", "豁免清单裁决"]
  },
  "stage_special": {
    "资产梳理": "has:domain",
    "端口扫描": "has:port",
    "子域枚举": "text:子域"
  }
}
